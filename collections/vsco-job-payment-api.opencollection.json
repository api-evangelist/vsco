{
  "opencollection": "1.0.0",
  "info": {
    "name": "VSCO Workspace Brands Job Payment API",
    "version": "v2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Job Payment",
        "type": "folder"
      },
      "items": [
        {
          "info": {
