            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ULID to perform an action on."
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "Sort items in the collection by the given property."
              }
            ]
          },
          "docs": "Get a list of payments for a specific job"
        }
      ]
    }
  ],
  "bundled": true
}