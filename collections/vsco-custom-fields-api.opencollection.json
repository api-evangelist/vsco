                "description": "ULID to perform an action on."
              }
            ]
          },
          "docs": "Get a specific Custom Field"
        },
        {
          "info": {
            "name": "Update a specific Custom Field",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://tave.io/v2/custom-field/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ULID to perform an action on."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a specific Custom Field"
        },
        {
          "info": {
            "name": "Delete a Custom Field.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://tave.io/v2/custom-field/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ULID to perform an action on."
              }
            ]
          },
          "docs": "Delete a Custom Field."
