{
  "opencollection": "1.0.0",
  "info": {
    "name": "VSCO Workspace Brands Custom Fields API",
    "version": "v2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
