              },
              {
                "name": "kind",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "Sort items in the collection by the given property."
              }
            ]
          },
          "docs": "List of Custom Fields on a studio"
        },
        {
          "info": {
            "name": "Create a custom field.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://tave.io/v2/custom-field",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
