        },
        {
          "info": {
            "name": "Get a specific Custom Field",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tave.io/v2/custom-field/:id",
            "params": [
              {
                "name": "id",
                "value": "",
