{
  "opencollection": "1.0.0",
  "info": {
    "name": "VSCO Workspace Brands File Types API",
    "version": "v2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "File Types",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List file types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tave.io/v2/file-type",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page of results to return."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of results per page to return in the collection."
              },
              {
                "name": "includeHidden",
                "value": "",
                "type": "query",
                "description": "Include objects that have been hidden"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "Sort items in the collection by the given property."
              }
            ]
          },
          "docs": "List file types"
        },
        {
          "info": {
            "name": "Get a specific file type",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tave.io/v2/file-type/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ULID to perform an action on."
              }
            ]
          },
          "docs": "Get a specific file type"
        }
      ]
    }
  ],
  "bundled": true
}